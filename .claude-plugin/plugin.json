{
  "name": "odoo-accounting",
  "version": "0.3.1",
  "description": "Odoo Accounting coworker: flexible read-only access to invoices, bills, partners, payments, journals, chart of accounts, taxes, banking, and analytic accounting through the connected tenant.",
  "author": {
    "name": "Sadeef"
  },
  "keywords": ["odoo", "accounting", "invoices", "bills", "payments", "journals", "erp", "receivables", "payables", "banking", "reporting"],
  "runtime": {
    "module": "sadeef_plugins.odoo_accounting.runtime",
    "entrypoint": "PLUGIN_RUNTIME"
  },
  "connectors": [
    {
      "plugin_id": "odoo-accounting",
      "plugin_version": "0.3.1",
      "id": "odoo",
      "protocol": "jsonrpc",
      "base_url": "https://sadeefcapital.odoo.com",
      "credentials": [
        {"id": "base_url", "type": "url", "required": true},
        {"id": "database", "type": "string", "required": true},
        {"id": "username", "type": "string", "required": true},
        {"id": "api_key", "type": "secret", "required": true}
      ],
      "operations": [
        {"id": "odoo_discover_models", "mode": "read", "method": "POST", "path": "/jsonrpc", "input_schema": {"type": "object"}},
        {"id": "odoo_discover_fields", "mode": "read", "method": "POST", "path": "/jsonrpc", "input_schema": {"type": "object", "properties": {"model": {"type": "string"}}, "required": ["model"]}},
        {
          "id": "odoo_read",
          "mode": "read",
          "method": "POST",
          "path": "/jsonrpc",
          "input_schema": {
            "type": "object",
            "properties": {
              "model": {"type": "string", "description": "Technical Odoo model name discovered from the tenant"},
              "domain": {"type": "array", "description": "Odoo domain filter list"},
              "fields": {"type": "array", "description": "Explicit fields discovered for the model"},
              "limit": {"type": "integer", "minimum": 1, "maximum": 200}
            },
            "required": ["model", "fields"],
            "additionalProperties": false
          }
        }
      ],
      "bindings": [
        {"skill": "odoo-accounting", "operations": ["odoo_discover_models", "odoo_discover_fields", "odoo_read"]},
        {"skill": "odoo-receivables", "operations": ["odoo_discover_models", "odoo_discover_fields", "odoo_read"]},
        {"skill": "odoo-payables", "operations": ["odoo_discover_models", "odoo_discover_fields", "odoo_read"]},
        {"skill": "odoo-banking", "operations": ["odoo_discover_models", "odoo_discover_fields", "odoo_read"]},
        {"skill": "odoo-reporting", "operations": ["odoo_discover_models", "odoo_discover_fields", "odoo_read"]},
        {"skill": "odoo-api-reference", "operations": ["odoo_discover_models", "odoo_discover_fields", "odoo_read"]},
        {"skill": "odoo-discovery", "operations": ["odoo_discover_models", "odoo_discover_fields", "odoo_read"]}
      ]
    }
  ]
}
